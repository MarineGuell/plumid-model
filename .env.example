# =====================================================================
# Plum'ID model service — environment template
# =====================================================================

# Logging
LOG_LEVEL=INFO

# Network (Railway sets PORT automatically)
PORT=8001

# Upload guardrails
MAX_UPLOAD_BYTES=10000000

# =====================================================================
# HuggingFace model
# ---------------------------------------------------------------------
# Required: the repo to download the trained .pth from.
# =====================================================================
HF_REPO_ID=Azerty112/Plum_ID_V1

# Optional: pin a specific weights file (otherwise the loader picks the
# only .pth in the repo, or the one with the highest "<n>%" in its name).
# HF_MODEL_FILENAME=model_V2_55%_Plum_ID.pth

# Optional: pin a git revision / branch / tag.
# HF_REVISION=main

# Optional: required only for private repos.
# HF_TOKEN=hf_xxx

# Optional: persist the HF cache across deploys to avoid re-downloading
# the weights on every cold boot. On Railway, attach a volume here.
HF_HOME=/home/appuser/.cache/huggingface

# =====================================================================
# Model behaviour overrides (rarely needed)
# =====================================================================

# Force a number of classes — by default it's inferred from the last
# linear layer of the state_dict, which is the safe option.
# MODEL_NUM_CLASSES=6

# Comma-separated species names in the model output order. Defaults to
# the 6 species seeded in the API's database.
# MODEL_CLASS_NAMES=Pie bavarde (Pica pica),Pic épeiche (Dendrocopos major),Perruche à collier (Psittacula krameri),Geai des chênes (Garrulus glandarius),Corneille noire (Corvus corone),Canard colvert (Anas platyrhynchos)

# Force an architecture if the auto-detector cannot recognise the model.
# Supported: resnet18, resnet34, resnet50, resnet101, resnet152,
#            efficientnet_b0..b3, mobilenet_v2.
# MODEL_ARCHITECTURE=resnet18

# Override the input size and ImageNet normalisation if the model was
# trained with non-standard preprocessing.
# MODEL_INPUT_SIZE=224
# MODEL_NORM_MEAN=0.485,0.456,0.406
# MODEL_NORM_STD=0.229,0.224,0.225

# Eagerly load the model in a background thread on startup (default 1).
# Set to 0 to defer until the first /predict call.
PRELOAD_MODEL=1
